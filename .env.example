# 栖笺本地与生产环境示例。不要在这里填写或提交真实密钥。
NODE_ENV=development
APP_URL=http://localhost:3000
APP_HOST=localhost
APP_TIMEZONE_DEFAULT=Asia/Shanghai
LOG_LEVEL=info
TRUST_CLOUDFLARE_TUNNEL=false

# 最终自托管 PostgreSQL
DATABASE_URL=postgresql://qijian:change-me@postgres:5432/qijian
POSTGRES_DB=qijian
POSTGRES_USER=qijian
POSTGRES_PASSWORD=change-me

# 最终自托管 MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=qijian-ciphertext
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
MAX_ATTACHMENT_BYTES=524288000
MAX_ENTRY_ATTACHMENT_BYTES=1073741824
UPLOAD_CHUNK_BYTES=4194304

# 认证占位符
AUTH_MODE=development
SESSION_SECRET=generate-a-random-secret
APPLE_CLIENT_ID=com.everanz.qijian.web
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY_BASE64=BASE64_ENCODED_PRIVATE_KEY
APPLE_REDIRECT_URI=https://qijian.everanz.com/api/auth/callback/apple
PASSKEY_RP_ID=qijian.everanz.com
PASSKEY_RP_NAME=栖笺
PASSKEY_ORIGIN=https://qijian.everanz.com
BOOTSTRAP_ENROLLMENT_ENABLED=false

# Web Push
VAPID_SUBJECT=mailto:your-private-address@example.com
VAPID_PUBLIC_KEY=YOUR_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY

# Cloudflare 与运维
CLOUDFLARE_TUNNEL_TOKEN=YOUR_TUNNEL_TOKEN
AUDIT_IP_HMAC_KEY=generate-a-random-secret
BACKUP_REPOSITORY=/backups/qijian
BACKUP_PASSWORD_FILE=/run/secrets/backup_password
BACKUP_RETENTION_DAYS=30
